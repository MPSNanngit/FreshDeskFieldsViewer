{
  "getGroups": {
    "schema": {
      "method": "GET",
      "protocol": "https",
      "host": "<%= iparam.domain %>",
      "path": "/api/v2/groups?per_page=100",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.api_key) %>",
        "Content-Type": "application/json"
      }
    }
  },
  "getTicketFields": {
    "schema": {
      "method": "GET",
      "protocol": "https",
      "host": "<%= iparam.domain %>",
      "path": "/api/v2/ticket_fields",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.api_key) %>",
        "Content-Type": "application/json"
      }
    }
  },
  "getProducts": {
    "schema": {
      "method": "GET",
      "protocol": "https",
      "host": "<%= iparam.domain %>",
      "path": "/api/v2/products",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.api_key) %>",
        "Content-Type": "application/json"
      }
    }
  }
}