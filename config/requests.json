{
  "getGroups": {
    "schema": {
      "method": "GET",
      "host": "<%= context.domain %>",
      "path": "/api/v2/groups?per_page=100",
      "headers": {
        "Authorization": "Basic <%= encode(context.api_key + ':X') %>",
        "Content-Type": "application/json"
      }
    }
  },
  "getTicketFields": {
    "schema": {
      "method": "GET",
      "host": "<%= context.domain %>",
      "path": "/api/v2/ticket_fields",
      "headers": {
        "Authorization": "Basic <%= encode(context.api_key + ':X') %>",
        "Content-Type": "application/json"
      }
    }
  },
  "getProducts": {
    "schema": {
      "method": "GET",
      "host": "<%= context.domain %>",
      "path": "/api/v2/products",
      "headers": {
        "Authorization": "Basic <%= encode(context.api_key + ':X') %>",
        "Content-Type": "application/json"
      }
    }
  }
}